{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Debug VideoIndexer",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/tools/video_indexer.py",
            "console": "integratedTerminal",
            "args": [
                ".\\videos\\"
            ]
        }
    ]
}